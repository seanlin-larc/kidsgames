rules_version = '2';
// Firestore security rules for Kids Games (project kidsgame-7a262).
// Copy this whole file into Firebase console > Firestore > Rules, then click Publish.
// Family-only: only the accounts that have a players/{uid} document (SL, CJ, YC, JY, Guest, AMA)
// can read or write. The KidsChinese site uses this project too (block near the end).
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && exists(/databases/$(database)/documents/players/$(request.auth.uid));
    }
    function playerCode() {
      return get(/databases/$(database)/documents/players/$(request.auth.uid)).data.code;
    }

    // Fastest believable time (seconds) for each level. Faster times are rejected as fake.
    function minTimeOk(level, t) {
      return (level == 'l8'  && t >= 2)
          || (level == 'l12' && t >= 5)
          || (level == 'l16' && t >= 10)
          || (level == 'l20' && t >= 20)
          || (level == 'l24' && t >= 30);
    }

    // playedAt = when the game was played on the device (it can be sent later, after offline play).
    // It must be a timestamp from the last 30 days, and not more than 1 day ahead (device clocks vary).
    function playedAtOk(d) {
      return d.playedAt is timestamp
        && d.playedAt <= request.time + duration.value(1, 'd')
        && d.playedAt >= request.time - duration.value(30, 'd');
    }

    // players/{uid} = { code: "SL" }. Sean edits these in the console only.
    match /players/{uid} {
      allow read: if isFamily();
      allow write: if false;
    }

    // Minesweeper records: games/minesweeper/{level}/{recordId}
    match /games/minesweeper/{level}/{recordId} {
      allow read: if isFamily();
      allow create: if isFamily()
        && level in ['l8', 'l12', 'l16', 'l20', 'l24']
        && request.resource.data.keys().hasOnly(['player', 'time', 'date', 'uid', 'playedAt'])
        && request.resource.data.keys().hasAll(['player', 'time', 'date', 'uid'])
        && (!('playedAt' in request.resource.data) || playedAtOk(request.resource.data))
        && request.resource.data.player == playerCode()
        && request.resource.data.time is number
        && minTimeOk(level, request.resource.data.time)
        && request.resource.data.time < 10000
        && request.resource.data.date == request.time
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Every finished game (won or lost), for statistics for each player: results/{recordId}
    // score = seconds (Minesweeper) or number of guesses (Word Guess).
    match /results/{recordId} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.keys().hasOnly(['uid', 'player', 'game', 'level', 'won', 'score', 'playedAt', 'date'])
        && request.resource.data.keys().hasAll(['uid', 'player', 'game', 'level', 'won', 'score', 'playedAt', 'date'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.player == playerCode()
        && request.resource.data.game in ['minesweeper', 'word-guess']
        && request.resource.data.level is string
        && request.resource.data.level.size() <= 20
        && request.resource.data.won is bool
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score < 100000
        && request.resource.data.date == request.time
        && playedAtOk(request.resource.data);
      allow update, delete: if false;
    }

    // Shared puzzle library. SL and CJ can save and delete.
    // These checks protect metadata and the outer shape. The application validates
    // each block, board bounds, and overlap before saving and after reading.
    function puzzleIdOk(id) {
      return id.matches('[a-z0-9][a-z0-9-]{0,63}');
    }
    function puzzleShapeOk(d) {
      return d.keys().hasOnly(['format', 'title', 'difficulty', 'exitRow', 'pieces',
          'revision', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && d.keys().hasAll(['format', 'title', 'difficulty', 'exitRow', 'pieces',
          'revision', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && d.format == 'move-red-loco-puzzle-v1'
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && d.difficulty in ['Starter', 'Beginner', 'Amateur', 'Pro', 'Freak']
        && d.exitRow is int && d.exitRow in [2, 3]
        && d.pieces is list && d.pieces.size() <= 35
        && d.revision is int && d.revision >= 1 && d.revision <= 9007199254740990
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && d.createdBy is string && d.updatedBy is string;
    }
    match /puzzleLibrary/{puzzleId} {
      allow read: if isFamily();
      allow create: if isFamily() && playerCode() in ['SL', 'CJ']
        && puzzleIdOk(puzzleId)
        && puzzleShapeOk(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isFamily() && playerCode() in ['SL', 'CJ']
        && puzzleIdOk(puzzleId)
        && puzzleShapeOk(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isFamily() && playerCode() in ['SL', 'CJ'];
    }

    // Immutable completions belong to one account and one movement layout.
    match /puzzleProgress/{uid}/solved/{completionId} {
      allow read: if isFamily() && request.auth.uid == uid;
      allow create: if isFamily() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'puzzleId', 'layoutKey', 'moves', 'playedAt', 'date'])
        && request.resource.data.keys().hasAll(['uid', 'puzzleId', 'layoutKey', 'moves', 'playedAt', 'date'])
        && request.resource.data.uid == uid
        && request.resource.data.puzzleId is string
        && puzzleIdOk(request.resource.data.puzzleId)
        && request.resource.data.layoutKey is string
        && request.resource.data.layoutKey.matches('[a-f0-9]{64}')
        && completionId == request.resource.data.puzzleId + '-' + request.resource.data.layoutKey
        && request.resource.data.moves is int
        && request.resource.data.moves >= 0 && request.resource.data.moves < 100000
        && playedAtOk(request.resource.data)
        && request.resource.data.date == request.time;
      allow update, delete: if false;
    }

    // ---------- KidsChinese flash cards (https://seanlin-larc.github.io/kidsChinese/) ----------
    // KidsChinese uses this project and these accounts. Children: YC, JY. Parents: SL, CJ, AMA (嬤).
    // Guest has no access. The role comes from players/{uid}.code, like the rest of this file.
    // Tests: firebase/tests/kidschinese.rules.test.mjs. App: repo seanlin-larc/kidsChinese.
    //   chinese/{code}                 { level, updatedAt, updatedBy }   parents set the level (1–4)
    //   chinese/{code}/data/summary    { stars, streak, daily, updatedAt }
    //   chinese/{code}/data/prefs      { showPinyin, showEnglish, sessionSize, speechRate, avatar, updatedAt }
    //   chinese/{code}/cards/{cardId}  { box, due, seen, right, updatedAt }
    // Everyone studies: each account reads and writes its own progress and preferences.
    // A child cannot change the level. A parent reads both children, sets their levels, changes
    // their preferences, and resets their progress (deletes cards and the summary).
    // A parent also sets and resets their own level and progress (a test player).
    // A parent does not read another parent's data, and does not write card answers for others.
    function kcLearnerCode(code) {
      return code in ['YC', 'JY'];
    }
    function kcParentCode(code) {
      return code in ['SL', 'CJ', 'AMA'];
    }
    function kcParent() {
      return isFamily() && kcParentCode(playerCode());
    }
    function kcSelf(code) {
      return (kcLearnerCode(code) || kcParentCode(code)) && isFamily() && playerCode() == code;
    }
    // A parent manages a child, or themself.
    function kcManages(code) {
      return kcParent() && (kcLearnerCode(code) || playerCode() == code);
    }
    function kcCanRead(code) {
      return kcSelf(code) || (kcLearnerCode(code) && kcParent());
    }
    function kcDateOrNull(d) {
      return d == null || (d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
    }
    function kcCount(n, max) {
      return n is int && n >= 0 && n <= max;
    }
    function kcLevelOk(d) {
      return d.keys().hasOnly(['level', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['level', 'updatedAt', 'updatedBy'])
        && d.level in [1, 2, 3, 4]
        && d.updatedAt == request.time
        && d.updatedBy == playerCode();
    }
    function kcCardOk(d) {
      return d.keys().hasOnly(['box', 'due', 'seen', 'right', 'updatedAt'])
        && d.keys().hasAll(['box', 'due', 'seen', 'right', 'updatedAt'])
        && kcCount(d.box, 5)
        && kcDateOrNull(d.due)
        && kcCount(d.seen, 100000)
        && kcCount(d.right, 100000)
        && d.right <= d.seen
        && d.updatedAt == request.time;
    }
    function kcSummaryOk(d) {
      return d.keys().hasOnly(['stars', 'streak', 'daily', 'updatedAt'])
        && d.keys().hasAll(['stars', 'streak', 'daily', 'updatedAt'])
        && kcCount(d.stars, 10000000)
        && d.streak is map && d.streak.keys().hasOnly(['count', 'last']) && d.streak.keys().hasAll(['count', 'last'])
        && kcCount(d.streak.count, 100000) && kcDateOrNull(d.streak.last)
        && d.daily is map && d.daily.keys().hasOnly(['date', 'count']) && d.daily.keys().hasAll(['date', 'count'])
        && kcCount(d.daily.count, 100000) && kcDateOrNull(d.daily.date)
        && d.updatedAt == request.time;
    }
    function kcPrefsOk(d) {
      return d.keys().hasOnly(['showPinyin', 'showEnglish', 'sessionSize', 'speechRate', 'avatar', 'updatedAt'])
        && d.keys().hasAll(['showPinyin', 'showEnglish', 'sessionSize', 'speechRate', 'avatar', 'updatedAt'])
        && d.showPinyin is bool
        && d.showEnglish is bool
        && d.sessionSize in [5, 10, 15, 20]
        && d.speechRate is number && d.speechRate >= 0.5 && d.speechRate <= 1.5
        && d.avatar is string && d.avatar.size() <= 16
        && d.updatedAt == request.time;
    }
    match /chinese/{code} {
      allow read: if kcCanRead(code);
      allow create, update: if kcManages(code) && kcLevelOk(request.resource.data);
      allow delete: if false;

      match /cards/{cardId} {
        allow read: if kcCanRead(code);
        allow create, update: if kcSelf(code) && cardId.size() <= 64 && kcCardOk(request.resource.data);
        allow delete: if kcManages(code);
      }
      match /data/summary {
        allow read: if kcCanRead(code);
        allow create, update: if kcSelf(code) && kcSummaryOk(request.resource.data);
        allow delete: if kcManages(code);
      }
      match /data/prefs {
        allow read: if kcCanRead(code);
        allow create, update: if (kcSelf(code) || kcManages(code))
          && kcPrefsOk(request.resource.data);
        allow delete: if false;
      }
    }

    // Everything else stays locked.
  }
}
