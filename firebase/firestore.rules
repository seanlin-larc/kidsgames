rules_version = '2';
// Firestore security rules for Kids Games (project kidsgame-7a262).
// Copy this whole file into Firebase console > Firestore > Rules, then click Publish.
// Family-only: only the accounts that have a players/{uid} document (SL, CJ, YC, JY, Guest)
// can read or write.
service cloud.firestore {
  match /databases/{database}/documents {

    function isFamily() {
      return request.auth != null
        && exists(/databases/$(database)/documents/players/$(request.auth.uid));
    }
    function playerCode() {
      return get(/databases/$(database)/documents/players/$(request.auth.uid)).data.code;
    }

    // Fastest believable time (seconds) for each level. Faster times are rejected as fake.
    function minTimeOk(level, t) {
      return (level == 'l8'  && t >= 2)
          || (level == 'l12' && t >= 5)
          || (level == 'l16' && t >= 10)
          || (level == 'l20' && t >= 20)
          || (level == 'l24' && t >= 30);
    }

    // playedAt = when the game was played on the device (it can be sent later, after offline play).
    // It must be a timestamp from the last 30 days, and not more than 1 day ahead (device clocks vary).
    function playedAtOk(d) {
      return d.playedAt is timestamp
        && d.playedAt <= request.time + duration.value(1, 'd')
        && d.playedAt >= request.time - duration.value(30, 'd');
    }

    // players/{uid} = { code: "SL" }. Sean edits these in the console only.
    match /players/{uid} {
      allow read: if isFamily();
      allow write: if false;
    }

    // Minesweeper records: games/minesweeper/{level}/{recordId}
    match /games/minesweeper/{level}/{recordId} {
      allow read: if isFamily();
      allow create: if isFamily()
        && level in ['l8', 'l12', 'l16', 'l20', 'l24']
        && request.resource.data.keys().hasOnly(['player', 'time', 'date', 'uid', 'playedAt'])
        && request.resource.data.keys().hasAll(['player', 'time', 'date', 'uid'])
        && (!('playedAt' in request.resource.data) || playedAtOk(request.resource.data))
        && request.resource.data.player == playerCode()
        && request.resource.data.time is number
        && minTimeOk(level, request.resource.data.time)
        && request.resource.data.time < 10000
        && request.resource.data.date == request.time
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Every finished game (won or lost), for statistics for each player: results/{recordId}
    // score = seconds (Minesweeper) or number of guesses (Word Guess).
    match /results/{recordId} {
      allow read: if isFamily();
      allow create: if isFamily()
        && request.resource.data.keys().hasOnly(['uid', 'player', 'game', 'level', 'won', 'score', 'playedAt', 'date'])
        && request.resource.data.keys().hasAll(['uid', 'player', 'game', 'level', 'won', 'score', 'playedAt', 'date'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.player == playerCode()
        && request.resource.data.game in ['minesweeper', 'word-guess']
        && request.resource.data.level is string
        && request.resource.data.level.size() <= 20
        && request.resource.data.won is bool
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score < 100000
        && request.resource.data.date == request.time
        && playedAtOk(request.resource.data);
      allow update, delete: if false;
    }

    // Shared puzzle library. Players can read; only the server's SL account can change it.
    // These checks protect metadata and the outer shape. The application validates
    // each block, board bounds, and overlap before saving and after reading.
    function puzzleIdOk(id) {
      return id.matches('[a-z0-9][a-z0-9-]{0,63}');
    }
    function puzzleShapeOk(d) {
      return d.keys().hasOnly(['format', 'title', 'difficulty', 'exitRow', 'pieces',
          'revision', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && d.keys().hasAll(['format', 'title', 'difficulty', 'exitRow', 'pieces',
          'revision', 'createdAt', 'updatedAt', 'createdBy', 'updatedBy'])
        && d.format == 'move-red-loco-puzzle-v1'
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && d.difficulty in ['Starter', 'Beginner', 'Amateur', 'Pro', 'Freak']
        && d.exitRow is int && d.exitRow in [2, 3]
        && d.pieces is list && d.pieces.size() <= 35
        && d.revision is int && d.revision >= 1 && d.revision <= 9007199254740990
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && d.createdBy is string && d.updatedBy is string;
    }
    match /puzzleLibrary/{puzzleId} {
      allow read: if isFamily();
      allow create: if isFamily() && playerCode() == 'SL'
        && puzzleIdOk(puzzleId)
        && puzzleShapeOk(request.resource.data)
        && request.resource.data.revision == 1
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isFamily() && playerCode() == 'SL'
        && puzzleIdOk(puzzleId)
        && puzzleShapeOk(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isFamily() && playerCode() == 'SL';
    }

    // Everything else stays locked.
  }
}
